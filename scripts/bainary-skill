#!/usr/bin/env bash
# bainary-skill CLI
# Usage: bainary-skill <command> [options]

set -euo pipefail

VERSION="0.2.2"
BAINARY_DIR=".bainary"
SKILL_REPO="https://github.com/BainaryTD/bainary-skill"
RAW_REPO="${BAINARY_RAW_REPO:-https://raw.githubusercontent.com/BainaryTD/bainary-skill/main}"

BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
BLUE="\033[0;34m"
RED="\033[0;31m"
NC="\033[0m"

info()    { printf '%b\n' "${BLUE}[bainary-skill]${NC} $1"; }
success() { printf '%b\n' "${GREEN}[bainary-skill]${NC} $1"; }
warn()    { printf '%b\n' "${YELLOW}[bainary-skill]${NC} $1"; }
error()   { printf '%b\n' "${RED}[bainary-skill]${NC} $1" >&2; exit 1; }

fetch() {
  local url="$1" dest="$2"
  curl --fail --show-error --location --silent "$url" -o "$dest" \
    || error "Failed to download $url"
}

set_timestamp() {
  local file="$1" date_value="$2"
  if sed --version >/dev/null 2>&1; then
    sed -i "s/Last updated: .*/Last updated: $date_value/; s/<!-- DATE -->/$date_value/" "$file"
  else
    sed -i '' "s/Last updated: .*/Last updated: $date_value/; s/<!-- DATE -->/$date_value/" "$file"
  fi
}

file_modified() {
  local file="$1"
  if stat -c '%y' "$file" >/dev/null 2>&1; then
    stat -c '%y' "$file" | cut -d'.' -f1
  else
    stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S' "$file"
  fi
}

install_adapter() {
  local remote_path="$1" target="$2" force="$3"
  if [ -e "$target" ] && [ "$force" != true ]; then
    warn "$target already exists, skipping (use --force to replace)"
    return
  fi
  fetch "$RAW_REPO/$remote_path" "$target"
}

ensure_knowledge_files() {
  mkdir -p "$BAINARY_DIR"
  for file in project-knowledge.md architecture.md patterns.md conventions.md session-handoff.md; do
    if [ ! -f "$BAINARY_DIR/$file" ]; then
      info "Creating $BAINARY_DIR/$file from template..."
      fetch "$RAW_REPO/templates/.bainary/$file" "$BAINARY_DIR/$file"
    else
      warn "$BAINARY_DIR/$file already exists, skipping"
    fi
  done
  if [ ! -f "$BAINARY_DIR/skill-version" ]; then
    printf '%s\n' "$VERSION" > "$BAINARY_DIR/skill-version"
  fi
}

install_adapters() {
  local force="$1"
  info "Installing CLI instruction files..."
  install_adapter "adapters/claude/CLAUDE.md"     "CLAUDE.md"     "$force"
  install_adapter "adapters/codex/AGENTS.md"      "AGENTS.md"      "$force"
  install_adapter "adapters/cursor/.cursorrules"  ".cursorrules"  "$force"
  install_adapter "adapters/cursor/CURSOR.md"     "CURSOR.md"     "$force"
  install_adapter "adapters/aider/CONVENTIONS.md" "CONVENTIONS.md" "$force"
}

update_timestamps() {
  local date_value
  date_value=$(date +"%Y-%m-%d %H:%M")
  for file in project-knowledge.md session-handoff.md; do
    [ -f "$BAINARY_DIR/$file" ] && set_timestamp "$BAINARY_DIR/$file" "$date_value"
  done
}

# ── Detect if running as project-local ──────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CURRENT_DIR="$(pwd)"
IS_LOCAL=false
if [[ "$SCRIPT_DIR" == "$CURRENT_DIR/bin" || "$SCRIPT_DIR" == "$CURRENT_DIR/scripts" ]]; then
  IS_LOCAL=true
fi

cmd_learn() {
  local force="${1:-false}"
  info "Starting project discovery..."
  ensure_knowledge_files
  install_adapters "$force"
  update_timestamps
  success "Done! Fill in .bainary/ files with your project context."
  echo ""
  echo "  Next steps:"
  echo "    1. Ask your AI to read .bainary/ and inspect source code for project style"
  echo "    2. Edit .bainary/project-knowledge.md  — describe your project"
  echo "    3. Edit .bainary/architecture.md       — document key decisions"
  echo "    4. Edit .bainary/conventions.md        — define naming rules"
  echo "    5. Before ending each AI chat, update .bainary/session-handoff.md"
  if [ "$IS_LOCAL" = true ]; then
    echo "    6. Run: ./bin/bainary-skill update     — refresh after changes"
  else
    echo "    6. Run: bainary-skill update           — refresh after changes"
  fi
}

cmd_update() {
  local force="${1:-false}"
  info "Refreshing CLI instruction files from latest skill version..."
  [ -d "$BAINARY_DIR" ] || error "No .bainary/ directory found. Run '$(basename "$0") learn' first."
  ensure_knowledge_files
  install_adapters "$force"
  printf '%s\n' "$VERSION" > "$BAINARY_DIR/skill-version"
  update_timestamps
  success "Updated! Remember to manually update .bainary/ if architecture changed."
}

cmd_status() {
  info "bainary-skill status"
  if [ "$IS_LOCAL" = true ]; then
    printf '  %b\n' "${YELLOW}(project-local install)${NC}"
  else
    printf '  %b\n' "${GREEN}(global install)${NC}"
  fi
  echo ""

  if [ ! -d "$BAINARY_DIR" ]; then
    warn ".bainary/ not found — run '$(basename "$0") learn' to initialize"
    exit 0
  fi

  printf '%b\n' "${BOLD}Knowledge files:${NC}"
  for file in project-knowledge.md architecture.md patterns.md conventions.md session-handoff.md skill-version; do
    if [ -f "$BAINARY_DIR/$file" ]; then
      lines=$(wc -l < "$BAINARY_DIR/$file")
      modified=$(file_modified "$BAINARY_DIR/$file")
      printf '  %b\n' "${GREEN}✓${NC} $file  (${lines} lines, modified: ${modified})"
    else
      printf '  %b\n' "${RED}✗${NC} $file  ${RED}(missing)${NC}"
    fi
  done

  echo ""
  printf '%b\n' "${BOLD}CLI instruction files:${NC}"
  for file in CLAUDE.md AGENTS.md .cursorrules CURSOR.md CONVENTIONS.md; do
    if [ -f "$file" ]; then
      printf '  %b\n' "${GREEN}✓${NC} $file"
    else
      printf '  %b\n' "${YELLOW}–${NC} $file  (not installed)"
    fi
  done
}

cmd_install() {
  local mode="${1:-local}"
  if [ "$mode" = "global" ]; then
    info "Running global installer..."
    fetch "$RAW_REPO/install.sh" "/tmp/bainary-skill-install.sh"
    bash /tmp/bainary-skill-install.sh
  else
    info "Running project-local installer..."
    fetch "$RAW_REPO/install.sh" "/tmp/bainary-skill-install.sh"
    bash /tmp/bainary-skill-install.sh --local
  fi
}

cmd_help() {
  printf '%b\n' "${BOLD}bainary-skill${NC} — Web Development Base Skill v${VERSION}"
  echo ""
  printf '%b\n' "Usage: ${BOLD}bainary-skill${NC} <command> [options]"
  echo ""
  printf '%b\n' "${BOLD}Commands:${NC}"
  echo "  learn [--force]      Initialize .bainary/ knowledge + install CLI instruction files"
  echo "  update [--force]     Refresh CLI files from latest skill version"
  echo "  status               Show knowledge state and installed files"
  echo "  install [--global]   Re-install this CLI (default: project-local)"
  echo "  help                 Show this help"
  echo ""
  echo "  --force              Replace existing CLI instruction files; knowledge files are never overwritten"
  echo ""
  echo "  Project: $SKILL_REPO"
}

force=false
case "${1:-help}" in
  learn|update)
    [ "${2:-}" = "--force" ] && force=true
    [ -z "${2:-}" ] || [ "$force" = true ] || error "Unknown option: $2"
    "cmd_$1" "$force"
    ;;
  status)  cmd_status ;;
  install) cmd_install "${2:-local}" ;;
  help|--help|-h) cmd_help ;;
  *) error "Unknown command: $1. Run '$(basename "$0") help' for usage." ;;
esac
